<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>

    <UI Id="TraceniumUI">

      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="InstallDir" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="CancelDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="ExitDialog" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="InvalidDirDlg" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="InstallDirDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="MaintenanceTypeDlg" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" />

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="EnrollmentTokenDlg" Order="2" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <Publish Dialog="EnrollmentTokenDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />
      <Publish Dialog="EnrollmentTokenDlg" Control="Next" Event="SpawnDialog" Value="MissingTokenDlg" Order="1" Condition="ENROLLMENT_TOKEN=&quot;&quot;" />
      <Publish Dialog="EnrollmentTokenDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="2" Condition="ENROLLMENT_TOKEN&lt;&gt;&quot;&quot;" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="EnrollmentTokenDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />

      <!--
        Cierre del ExitDialog (instalación exitosa). Sin esto, el
        botón Finish renderiza pero el msiexec.exe queda vivo hasta
        que el usuario lo mata desde Task Manager.

        WiX 6 cablea automáticamente FatalError y UserExit vía la
        librería WixUI_ErrorProgressText (referenciada en
        Product.wxs); declararlos aquí causa WIX0130. Solo el
        ExitDialog (camino feliz post-instalación) sigue requiriendo
        wiring manual. Probado con WiX 6.0.2.
      -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" />

    </UI>

  </Fragment>

  <Fragment>

    <UI>

      <Dialog Id="EnrollmentTokenDlg" Width="370" Height="270" Title="Tracenium Agent Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Enrollment token" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes" Text="You need a token to enroll this endpoint." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="TokenLabel" Type="Text" X="45" Y="85" Width="280" Height="15" Text="Enrollment token:" />
        <Control Id="TokenEdit" Type="Edit" X="45" Y="105" Width="280" Height="18" Property="ENROLLMENT_TOKEN" Password="yes" />
        <Control Id="TokenHelp" Type="Text" X="45" Y="132" Width="280" Height="30" Text="You can generate a token fromTracenium portal." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="MissingTokenDlg" Width="260" Height="85" Title="Tracenium Agent Setup">
        <Control Id="Message" Type="Text" X="15" Y="15" Width="230" Height="30" Text="Enrollment token is required to install Tracenium Agent." />
        <Control Id="OK" Type="PushButton" X="102" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="OK">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

    </UI>

  </Fragment>

</Wix>
