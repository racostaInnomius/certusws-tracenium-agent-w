<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>

    <ComponentGroup Id="PrivSvcComponent">

      <!-- ============================= -->
      <!-- Privileged Service -->
      <!-- ============================= -->

      <Component Id="PrivSvcServiceComponent"
                 Directory="PRIVSVC_DIR"
                 Guid="*">

        <File Id="PrivSvcExe"
              Source="binaries\PrivSvc\Tracenium.PrivSvc.Windows.exe"
              KeyPath="yes"/>

        <ServiceInstall
            Id="InstallPrivSvc"
            Name="TraceniumPrivSvc"
            DisplayName="Tracenium Privilege Service"
            Description="Tracenium privileged cryptographic service"
            Start="auto"
            Type="ownProcess"
            ErrorControl="normal"
            Account="LocalSystem" />

        <!-- ── Note on missing util:ServiceConfig ──
             We previously embedded a <util:ServiceConfig> element here
             to wire SCM restart-on-failure actions (so privsvc would
             be resurrected when GrpcBridge.cs calls Environment.Exit(2)
             from the self-rescue path). That broke MSI install with
             "Service 'Tracenium Agent Core' failed to start" because
             AgentCore depends on PrivSvc via <ServiceDependency> and
             PrivSvc's ServiceInstall didn't reach SERVICE_RUNNING
             during the InstallExecuteSequence — suspected cause is
             the way util.wixext 6.0.0 schedules the
             MsiInstallServiceConfig action vs StartServices.

             Until we either:
               (a) move the failure-actions config out-of-band via a
                   CustomAction calling `sc.exe failure ... actions=
                   restart/5000/restart/5000/`, or
               (b) use the native WiX 6 ServiceConfigFailureActions
                   element with explicit sequencing,
             we ship without SCM-mediated restart. The self-rescue
             Environment.Exit(2) call still runs, just nothing
             resurrects the process after — equivalent to the pre-
             self-rescue behavior, no regression vs 1.1.16. -->

        <!-- Control lifecycle -->
        <ServiceControl
            Id="PrivSvcControl"
            Name="TraceniumPrivSvc"
            Stop="both"
            Start="install"
            Remove="uninstall"
            Wait="yes"/>

      </Component>


      <!-- ============================= -->
      <!-- Root CA Asset -->
      <!-- ============================= -->

      <Component Id="PrivSvcRootCAComponent"
                 Directory="PRIVSVC_ASSETS_DIR"
                 Guid="*">

        <File Id="RootCAFile"
              Source="assets\root-ca.crt"
              KeyPath="yes"
              Vital="yes"/>

      </Component>

    </ComponentGroup>

  </Fragment>

</Wix>