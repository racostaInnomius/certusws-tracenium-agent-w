<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>

    <ComponentGroup Id="AgentCoreFiles">

      <!-- ============================= -->
      <!-- WinSW Service -->
      <!-- ============================= -->

      <Component Id="AgentCoreService"
                 Directory="AGENTCORE_DIR"
                 Guid="3ee4b2f9-71af-4d35-bf59-ae1e30c6a078">

        <File Id="WinSWExe"
              Source="binaries\AgentCore\TraceniumAgentCore.exe"
              KeyPath="yes"/>

        <File Id="WinSWXml"
              Source="binaries\AgentCore\TraceniumAgentCore.xml"/>

        <!-- ============================= -->
        <!-- Registry configuration -->
        <!-- ============================= -->

        <RegistryKey Root="HKLM"
                     Key="Software\CertusWS\Tracenium">

          <RegistryValue Name="ENROLLMENT_TOKEN"
                         Type="string"
                         Value="[ENROLLMENT_TOKEN]"/>

          <RegistryValue Name="ServerBaseUrl"
                         Type="string"
                         Value="https://api.tracenium.com" />

        </RegistryKey>

        <!-- ============================= -->
        <!-- Windows Service installation -->
        <!-- ============================= -->

        <ServiceInstall
            Id="InstallAgentCore"
            Name="TraceniumAgentCore"
            DisplayName="Tracenium Agent Core"
            Description="Tracenium Endpoint Agent"
            Start="auto"
            Type="ownProcess"
            ErrorControl="normal"
            Account="LocalSystem">

          <!-- CRÍTICO: dependencia explícita -->
          <ServiceDependency Id="TraceniumPrivSvc"/>

        </ServiceInstall>

        <!-- Control lifecycle -->
        <ServiceControl
            Id="AgentCoreControl"
            Name="TraceniumAgentCore"
            Stop="both"
            Start="install"
            Remove="uninstall"
            Wait="yes"/>

      </Component>


      <!-- ============================= -->
      <!-- Node runtime -->
      <!-- ============================= -->

      <!--
        WiX 6 resuelve <Files Include> relativo al cwd donde se invocó
        `wix build` (= la raíz del installer dir), no al .wxs. Por eso
        las rutas van SIN `..\` al inicio. Si en el futuro se cambia a
        invocar wix build desde otro cwd, ajustar aquí o pasar
        -bindpath explícito.
      -->
      <Files Include="binaries\AgentCore\node\**\*"
             Directory="NODE_DIR" />


      <!-- ============================= -->
      <!-- Node application -->
      <!-- ============================= -->

      <Files Include="binaries\AgentCore\app\**\*"
             Directory="APP_DIR" />


      <!-- ============================= -->
      <!-- Logs folder -->
      <!-- ============================= -->

      <Component Id="LogsFolder"
                 Directory="LOGS_DIR"
                 Guid="1e00cbfe-0965-4d3f-b2e6-599512ec1234">

        <CreateFolder/>

      </Component>


      <!-- ============================= -->
      <!-- Watchdog script (Layer 3 of 3) -->
      <!-- ============================= -->

      <Component Id="WatchdogScriptComponent"
                 Directory="AGENTCORE_DIR"
                 Guid="{61c34c01-0c6f-4ef9-a62e-4768ddd5d419}">

        <File Id="WatchdogScriptFile"
              Source="binaries\AgentCore\scripts\register-watchdog.ps1"
              Name="register-watchdog.ps1"
              KeyPath="yes"/>

      </Component>


      <!-- ============================= -->
      <!-- Interactive tray app -->
      <!-- ============================= -->

      <!--
        AgentTray es single-file self-contained: el publish produce
        UN SOLO Tracenium.AgentTray.exe sin DLLs ni archivos auxiliares
        (managed assemblies van comprimidos dentro del EXE; native libs
        se extraen a %TEMP% en runtime vía IncludeNativeLibrariesForSelfExtract).
        Por eso no hay <Files Include="**\*"> harvest aquí — el File
        explícito de arriba es suficiente. Si en el futuro el csproj
        cambia a multi-file publish, agregar el harvest de vuelta —
        WiX 4 NO soporta Exclude en <Files>, así que no se puede
        excluir el .exe del glob; toca usar Subdirectory con un dir
        intermedio o cambiar a <ComponentGroup> con archivos listados
        a mano.
      -->
      <Component Id="AgentTrayComponent"
                 Directory="AGENTTRAY_DIR"
                 Guid="*">

        <File Id="AgentTrayExe"
              Source="binaries\AgentTray\Tracenium.AgentTray.exe"
              KeyPath="yes"/>

        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="TraceniumAgentTray"
                       Type="string"
                       Value="&quot;[AGENTTRAY_DIR]Tracenium.AgentTray.exe&quot;"/>

      </Component>

    </ComponentGroup>


    <!-- ====================================================================
         Service Recovery (Layer 2 of 3)
         Configures Windows SCM to restart TraceniumAgentCore on failure.
         Independent of WinSW — kicks in if WinSW itself fails or gives up.
         Counter resets daily (86400 seconds).
         Using sc.exe directly (not util:ServiceConfig) to avoid the
         InstallExecuteSequence ordering issue with WixToolset.Util.wixext 6
         that broke v1.1.16+ (see PrivSvc.wxs lines 29-50 for history).
         ==================================================================== -->
    <CustomAction Id="ConfigureAgentCoreRecovery"
                  Directory="INSTALLFOLDER"
                  ExeCommand='sc.exe failure "TraceniumAgentCore" reset= 86400 actions= restart/60000/restart/60000/restart/120000'
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no"/>

    <!-- ====================================================================
         Watchdog Scheduled Task (Layer 3 of 3) — last-resort safety net.
         Runs every 5 min as SYSTEM; ensures the service is Running.
         ==================================================================== -->
    <CustomAction Id="RegisterTraceniumWatchdog"
                  Directory="INSTALLFOLDER"
                  ExeCommand='powershell.exe -ExecutionPolicy Bypass -NoProfile -WindowStyle Hidden -File "[#WatchdogScriptFile]"'
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no"/>

    <CustomAction Id="UnregisterTraceniumWatchdog"
                  Directory="INSTALLFOLDER"
                  ExeCommand='powershell.exe -ExecutionPolicy Bypass -NoProfile -WindowStyle Hidden -Command "Unregister-ScheduledTask -TaskName TraceniumWatchdog -Confirm:$false -ErrorAction SilentlyContinue"'
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no"/>

    <InstallExecuteSequence>
      <!-- Configure recovery + register watchdog after service is installed
           but before it starts.

           These used to carry Condition="NOT Installed OR REINSTALL". That
           looks right, but it silently skipped both layers on any install
           that Windows did not classify as a fresh install or an explicit
           reinstall — which is exactly what the fleet went through while the
           MSI was shipping a hardcoded ProductVersion 1.1.21 and MajorUpgrade
           was therefore dead (see Product.wxs history). Hosts installed in
           that window ended up with NO SCM failure actions and NO watchdog
           task, and nothing ever re-applied them, because the condition only
           fires on the install shapes those hosts never see again.

           Found in the field in August 2026: a 1.1.35 host answered
           `sc qfailure TraceniumAgentCore` with RESET_PERIOD 0 and no
           actions at all. Its AgentCore crashed and stayed down for days —
           layer 2 and layer 3 were both absent.

           Both actions are idempotent (`sc.exe failure` overwrites;
           register-watchdog.ps1 re-registers), so there is nothing to gain
           from conditioning them and a whole outage to lose. Run them every
           time. The PrivSvc re-applies the recovery policy at every start as
           well (ServiceRecovery.cs) so already-deployed hosts get repaired
           without waiting for an upgrade to reach them. -->
      <Custom Action="ConfigureAgentCoreRecovery" After="InstallServices"/>
      <Custom Action="RegisterTraceniumWatchdog"  After="ConfigureAgentCoreRecovery"/>

      <!-- Remove watchdog on full uninstall only (NOT on upgrade). -->
      <Custom Action="UnregisterTraceniumWatchdog" Before="RemoveExistingProducts"   Condition='REMOVE="ALL"'/>
    </InstallExecuteSequence>

  </Fragment>

</Wix>
