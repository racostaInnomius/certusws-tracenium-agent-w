<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Win32 VersionInfo resource — populated by MSBuild into the
         emitted PE. Shows up in Explorer Properties → Details tab,
         Task Manager "Verified Signer" column, and (most importantly)
         contributes to the binary's Authenticode reputation footprint
         when the Trusted Signing cert builds rep across Defender's
         cloud. Company MUST match the cert subject (CERTUS ITM LLC) so
         the Publisher fields line up consistently. -->
    <Company>CERTUS ITM LLC</Company>
    <Product>Tracenium Agent</Product>
    <Authors>CERTUS ITM LLC</Authors>
    <Copyright>Copyright © CERTUS ITM LLC</Copyright>
    <AssemblyTitle>Tracenium Agent Tray</AssemblyTitle>
    <Description>Tracenium Agent — system tray status indicator</Description>

    <!-- Permite ejecutar `dotnet publish -r win-x64` desde macOS/Linux.
         Sin esto el SDK rechaza el TargetFramework net8.0-windows fuera
         de Windows con NETSDK1100. Solo afecta al build, no al runtime. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Tray icon: tracenium.ico está en la raíz del proyecto (junto al
         .csproj). Lo usamos para:
           1. ApplicationIcon: el icono que Explorer muestra para el
              .exe en disco y en Apps & Features.
           2. EmbeddedResource: el icono que TrayIconLoader.LoadOrFallback()
              carga en runtime para el NotifyIcon de la system tray.
         macOS sigue usando ../../Tracenium_tryicon.png (PNG) — esto es
         exclusivo de Windows porque la system tray prefiere ICO con
         múltiples resoluciones (16/24/32/48/256) para escalar bien en
         distintos DPI scales. -->
    <ApplicationIcon>tracenium.ico</ApplicationIcon>
    <TrayIconSourcePath>$(MSBuildThisFileDirectory)tracenium.ico</TrayIconSourcePath>
    <TrayIconResourceName>Tracenium.AgentTray.tracenium.ico</TrayIconResourceName>

    <!--
      Single-file self-contained publish con compresión.
      Target: ~25 MB en disco vs ~70 MB sin comprimir.

      Mantenemos self-contained porque los endpoints no tienen .NET 8
      Desktop Runtime, y compartir con PrivSvc no es viable: PrivSvc
      ya es single-file y extrae su runtime a %TEMP% solo mientras
      corre — no expone una carpeta on-disk que el AgentTray pueda
      apuntar vía DOTNET_ROOT. Si en el futuro se decide bundlear el
      runtime separado en un Runtime\dotnet\ común, cambiar
      SelfContained=false y dejar que apphost lo encuentre vía la env
      var DOTNET_ROOT.

      OJO: NO declaramos <IncludeAllContentForSelfExtract>true</...>
      aquí. Cuando ese flag está activo, MSBuild ignora silenciosamente
      EnableCompressionInSingleFile y el EXE final queda en ~70 MB
      (validado empíricamente: con IncludeAllContent salía 71.7 MB,
      sin él baja a ~25 MB). El runtime de single-file extrae las
      native libs a %TEMP% via IncludeNativeLibrariesForSelfExtract;
      los managed assemblies se quedan dentro del EXE comprimidos y
      se cargan vía bundle reader sin tocar disco. Eso es suficiente
      para una WinForms app pequeña como esta.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- Logical resource name: Tracenium.AgentTray.tracenium.ico
         (default namespace + filename). El TrayIconLoader.cs lo
         busca con ese string exacto. -->
    <EmbeddedResource Include="tracenium.ico" />
    <!-- Logo a color del header del status form. Mismo mecanismo que el .ico:
         BrandAssets.LoadLogoOrNull() lo resuelve por logical name. Devuelve
         null si falta, así que un fallo de empaquetado degrada el header en
         vez de tumbar el tray. -->
    <EmbeddedResource Include="tracenium_logo_color.png" />
  </ItemGroup>

  <!--
    ===========================================================================
    Pre-build: assert the tray icon source ICO is present and non-empty.

    Without this guard, a missing/zero-byte file would silently produce a
    build where TrayIconLoader.LoadOrFallback() returns SystemIcons.Application
    at runtime and the user sees the generic Windows icon instead of the
    Tracenium one. We fail loud and early.
    ===========================================================================
  -->
  <Target Name="ValidateTrayIconSource" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(TrayIconSourcePath)')"
           Text="Tray icon source ICO missing: $(TrayIconSourcePath). Build aborted." />
    <Message Importance="high"
             Text="Tray icon source OK: $(TrayIconSourcePath)" />
  </Target>

  <!--
    ===========================================================================
    Post-build: load the produced assembly via reflection in a separate
    PowerShell process (so it is GC'd and not locked) and assert that the
    manifest contains the expected embedded resource name. If the
    EmbeddedResource Include attribute drifts from the constant in
    TrayIconLoader.cs (Tracenium.AgentTray.tracenium.ico), this target
    fails the build before the MSI can pick up a broken EXE.
    ===========================================================================
  -->
  <!--
    Condition (extended May 2026):
      OS == Windows_NT
        Skip on Mac/Linux hosts — System.Reflection.Assembly.LoadFile
        requires a Windows .NET runtime AND a compatible target arch.
      AND SkipVerifyTrayIcon != true
        Explicit skip flag (passed via -p:SkipVerifyTrayIcon=true from
        build-windows-binaries.sh when cross-compiling). This is the
        primary skip mechanism — the auto-detection below is a backup
        for hand-run `dotnet publish` invocations that don't go through
        our script.
      AND (RuntimeIdentifier empty OR matches host SDK's RID)
        Skip when CROSS-COMPILING between Windows archs (host x64 →
        target arm64, or vice versa). The DLL emitted is for the
        TARGET arch and the HOST's runtime can't LoadFile it across
        archs ("BadImageFormatException: This assembly was compiled
        for a different processor"). The verification still runs on
        same-arch builds (most common dev + CI case for the primary
        arch); the cross-arch build is covered by:
          - <ValidateTrayIconSource> BeforeBuild (icon source exists)
          - MSBuild's native <EmbeddedResource> processing (resource
            name derived from project namespace + filename — drift
            shows up immediately at runtime on either arch).
  -->
  <Target Name="VerifyTrayIconEmbedded"
          AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' AND '$(SkipVerifyTrayIcon)' != 'true' AND ('$(RuntimeIdentifier)' == '' OR '$(RuntimeIdentifier)' == '$(NETCoreSdkRuntimeIdentifier)')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$ErrorActionPreference='Stop'; $asm=[System.Reflection.Assembly]::LoadFile((Resolve-Path '$(TargetPath)').Path); $names=$asm.GetManifestResourceNames(); $expected='$(TrayIconResourceName)'; if ($names -notcontains $expected) { Write-Host ('Embedded resources found: ' + ($names -join ', ')); throw ('Expected embedded resource missing: ' + $expected) }; $stream=$asm.GetManifestResourceStream($expected); if ($stream -eq $null) { throw ('Resource stream null for: ' + $expected) }; if ($stream.Length -le 0) { throw ('Resource stream is empty for: ' + $expected) }; Write-Host ('Tray icon embedded OK: ' + $expected + ' (' + $stream.Length + ' bytes)')&quot;"
          ConsoleToMsBuild="true" />
  </Target>

  <!--
    Cross-compile coverage notes (when VerifyTrayIconEmbedded is skipped):
      - BeforeBuild ValidateTrayIconSource catches a missing ICO file
      - MSBuild's <EmbeddedResource> processes the icon natively
      - If the resource NAME ever drifts (rename, namespace move),
        TrayIconLoader.LoadOrFallback() falls back to SystemIcons.Application
        at runtime — the agent doesn't crash, the tray just shows a
        generic Windows icon. Tolerable degradation.
      - build-windows-binaries.sh validates that the EXE produced has
        a reasonable size as an operational sanity check.
  -->
</Project>
