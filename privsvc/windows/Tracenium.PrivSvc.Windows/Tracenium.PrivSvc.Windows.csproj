<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <OutputType>Exe</OutputType>
    <UseWindowsService>true</UseWindowsService>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>

    <!-- Permite ejecutar `dotnet publish -r win-x64` desde macOS/Linux.
         Sin esto el SDK rechaza el TargetFramework net8.0-windows fuera
         de Windows con NETSDK1100. Solo afecta al build, no al runtime. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Win32 VersionInfo resource embedded into the emitted PE. Shows
         in Explorer Properties → Details, Task Manager "Verified Signer"
         column, and contributes to the binary's Authenticode reputation
         footprint when the Trusted Signing cert builds rep across
         Defender's cloud. Company MUST match the cert subject
         (CERTUS ITM LLC) so the Publisher fields line up consistently
         across the MSI, the binary, and the signature. -->
    <Company>CERTUS ITM LLC</Company>
    <Product>Tracenium Agent</Product>
    <Authors>CERTUS ITM LLC</Authors>
    <Copyright>Copyright © CERTUS ITM LLC</Copyright>
    <AssemblyTitle>Tracenium Privilege Service</AssemblyTitle>
    <Description>Tracenium Agent — privileged cryptographic + gRPC bridge service</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Google.Protobuf" Version="3.28.0" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- M3.S1 — GDI+ JPEG encoding for the screen.capture IPC handler.
         Supported on net8.0-windows; PrivSvc only ships on Windows. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- DPAPI machine-scope protection for the Infrastructure Gateway's vCenter
         credential (ADR-0001). Not in-box on .NET Core; first-party package. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- ADR-0015 — ML-DSA-65 GESTIONADO. NO se usa `MLDsa` de .NET 10: es
         una fachada sobre CNG, y ML-DSA en CNG sólo existe desde Windows
         11 25H2 / Server 2025. Los 12 Server 2022 de la flota no lo
         tendrán nunca, así que esa clase partiría la flota en dos.
         BouncyCastle es C# puro y da el mismo resultado en las dos.
         Verificado: sus firmas las validan OpenSSL 3.6 Y `@noble/post-
         quantum`, que es lo que usa el backend. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\root-ca.crt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- ADR-0022 — el colector de Assessment Service. Tiene que llegar a disco
         junto al binario, FIRMADO (release.yml lo incluye en el filtro de
         Trusted Signing): AspCollector se niega a ejecutarlo si el PrivSvc
         está firmado y el script no. Nunca se embebe ni se codifica. -->
    <Content Include="Scripts\asp-ad-collector.ps1">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- ADR-0023 — lectura de impresoras publicadas en AD (AMP). Mismas reglas:
         en disco junto al binario, firmado, nunca embebido ni codificado. -->
    <Content Include="Scripts\ad-printers.ps1">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Protobuf Include="..\..\..\proto\controlplane.proto"
              ProtoRoot="../../../proto"
              GrpcServices="Client" />
  </ItemGroup>

</Project>