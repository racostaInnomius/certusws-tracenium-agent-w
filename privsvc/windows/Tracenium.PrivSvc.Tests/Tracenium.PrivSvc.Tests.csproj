<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pruebas del PrivSvc de Windows.

       ⚠️ TFM `net8.0` a secas, y NO se referencia el proyecto del
       servicio. Ese es `net8.0-windows`, asi que un test que lo
       referenciara no podria EJECUTARSE fuera de Windows — y una suite
       que solo corre en una maquina que nadie tiene delante acaba sin
       correr.

       En su lugar se compila el fichero concreto bajo prueba. Funciona
       porque `CryptoKeyNames` es logica de texto pura, sin nada de
       Windows dentro; el dia que deje de serlo, esto dejara de
       compilar, que es el aviso correcto. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- El TFM se queda en net8.0, el MISMO que produccion: probar contra
         otra version del framework probaria otra cosa. `LatestMajor` es
         lo que permite ejecutarlo donde solo hay instalado el runtime de
         .NET 10, que es el caso de la maquina de desarrollo. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Tracenium.PrivSvc.Windows\Ipc\CryptoKeyNames.cs" />
    <Compile Include="..\Tracenium.PrivSvc.Windows\Ipc\DefenderStatusShape.cs" />
    <!-- ADR-0011 fase 0. `AnchorPin` tampoco tiene nada de Windows
         dentro: System.IO y System.Text.Json. Se compila aqui para
         poder probar de verdad la persistencia del veredicto, que es
         codigo nuevo en la plataforma donde el hallazgo del ancla se
         midio y donde una raiz plantada afecta a TODO el equipo. -->
    <Compile Include="..\Tracenium.PrivSvc.Windows\Ipc\AnchorPin.cs" />
    <!-- Sondas de registro (CIS Windows). La parte pura -parseo de la
         sonda, normalizacion del valor, extraccion de params- vive en
         RegistryProbeShape.cs precisamente para poder compilarse aqui;
         RegistryProbes.cs (Microsoft.Win32.Registry) se queda fuera. -->
    <Compile Include="..\Tracenium.PrivSvc.Windows\Ipc\RegistryProbeShape.cs" />
    <!-- Parseo de la salida de `gpresult`. Solo System y
         System.Collections.Generic: texto puro, sin nada de Windows
         dentro pese al namespace, asi que cumple la regla de arriba. -->
    <Compile Include="..\Tracenium.PrivSvc.Windows\Ipc\GpResultParsing.cs" />
    <!-- Los structs de P/Invoke de la inyeccion de entrada. Compila fuera de
         Windows porque un [DllImport] solo falla al LLAMARLO, y estas pruebas
         no llaman a user32: miden la disposicion en memoria, que es lo que se
         rompio tres veces en este modulo. -->
    <Compile Include="..\Tracenium.PrivSvc.Windows\Ipc\Protocol.cs" />
    <Compile Include="..\Tracenium.PrivSvc.Windows\Ipc\InputInjection.cs" />
    <!-- Fase 1 del cierre de brecha CIS: secedit completo, auditpol y
         sondas de registro de usuario. Las tres partes puras (parseo y
         agregación) se compilan aquí; los lectores que tocan Win32 no. -->
    <Compile Include="..\Tracenium.PrivSvc.Windows\Ipc\SeceditShape.cs" />
    <Compile Include="..\Tracenium.PrivSvc.Windows\Ipc\AuditpolShape.cs" />
    <Compile Include="..\Tracenium.PrivSvc.Windows\Ipc\UserRegistryProbeShape.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
