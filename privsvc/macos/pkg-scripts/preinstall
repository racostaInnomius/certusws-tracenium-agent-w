#!/bin/sh
set -eu

LOG_DIR="/Library/Application Support/Tracenium/Logs"
LOG_FILE="$LOG_DIR/installer.pkg.log"
/bin/mkdir -p "$LOG_DIR"
/usr/bin/touch "$LOG_FILE"
/bin/chmod 644 "$LOG_FILE" || true
exec >> "$LOG_FILE" 2>&1

echo "==== $(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ') preinstall start ===="
set -x
trap 'rc=$?; set +x; echo "==== $(/bin/date -u "+%Y-%m-%dT%H:%M:%SZ") preinstall exit rc=$rc ===="; exit $rc' EXIT

/bin/launchctl bootout system/com.certusws.tracenium.agent >/dev/null 2>&1 || true
/bin/launchctl bootout system/com.certusws.tracenium.privsvc >/dev/null 2>&1 || true

# La bandeja se para en TODAS las sesiones graficas, no solo en la del
# usuario de consola, y antes de que PackageKit reescriba el .app.
#
# 🔴 Antes solo se paraba la del dueño de /dev/console. Con la sesion abierta
# pero sin estar en pantalla —ventana de login, cambio rapido de usuario—
# no habia "usuario de consola", la bandeja seguia viva, el payload le
# reescribia el binario debajo y crasheaba; KeepAlive la relanzaba cada ~10 s
# contra un bundle a medio escribir hasta que llegaba el postinstall. En el
# iMac Intel de T1 (26-sep, disco de 2015) fueron 25 crashes en 4 minutos, y
# DEX lo pinto como "Unstable application: TraceniumAgentStatus".
#
# Mismo conjunto que el postinstall, que la vuelve a levantar en cada UID con
# dominio gui vivo: lo que se para aqui, se restaura alli.
STOPPED_AGENTS=0
for uid in $(/usr/bin/dscl . -list /Users UniqueID 2>/dev/null | /usr/bin/awk '$2 >= 500 && $2 < 60000 {print $2}'); do
  if /bin/launchctl print "gui/$uid" >/dev/null 2>&1; then
    /bin/launchctl bootout "gui/$uid/com.certusws.tracenium.agentstatus" >/dev/null 2>&1 || true
    STOPPED_AGENTS=$((STOPPED_AGENTS + 1))
  fi
done
echo "agent status LaunchAgent stopped in $STOPPED_AGENTS gui session(s)"

# Y la que launchd no gestiona (la del `open --args --setup`): `bootout` no la
# alcanza. DESPUES del bootout, o KeepAlive relanzaria lo que se acaba de matar.
/usr/bin/pkill -f "Tracenium Agent Status.app/Contents/MacOS/TraceniumAgentStatus" >/dev/null 2>&1 || true

exit 0
