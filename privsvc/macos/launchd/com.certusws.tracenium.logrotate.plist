<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.certusws.tracenium.logrotate</string>

  <!--
    Tracenium log rotation.

    launchd by default writes agent/privsvc stdout/stderr to the paths
    declared in their plists and NEVER rotates them. Over time those
    files grow unbounded. This job truncates-in-place any log file
    that exceeds 10 MB, keeping up to 5 gzipped historical copies.

    Truncate-in-place (`: > file`) preserves the inode that the
    daemon's stdout/stderr file descriptor is bound to, so we don't
    have to restart the daemon or send HUP.

    DOS directorios, no uno: además de los stdout/stderr en
    "Application Support/Tracenium/Logs", el privsvc de macOS escribe
    su propio log en /Library/Logs/Tracenium (ver privsvc/macos/src/
    paths.ts → LOG_DIR). Ese segundo directorio quedó fuera del barrido
    original y por lo tanto SIN rotar: crecía sin límite vía
    appendFileSync. Se agregó al bucle.
  -->

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>MAX=10485760; for LOG_DIR in "/Library/Application Support/Tracenium/Logs" "/Library/Logs/Tracenium"; do [ -d "$LOG_DIR" ] || continue; for f in "$LOG_DIR"/*.log; do [ -f "$f" ] || continue; size=$(/usr/bin/stat -f%z "$f" 2>/dev/null || echo 0); [ "$size" -gt "$MAX" ] || continue; for i in 4 3 2 1; do [ -f "$f.$i.gz" ] &amp;&amp; /bin/mv -f "$f.$i.gz" "$f.$((i+1)).gz"; done; /bin/cp "$f" "$f.1" &amp;&amp; /usr/bin/gzip -f "$f.1"; : &gt; "$f"; done; done</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Run every 30 minutes -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>StandardOutPath</key>
  <string>/Library/Application Support/Tracenium/Logs/logrotate.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Library/Application Support/Tracenium/Logs/logrotate.stderr.log</string>

  <key>ThrottleInterval</key>
  <integer>60</integer>
</dict>
</plist>
