[Unit]
# Tracenium Agent — non-privileged collector + scheduler.
#
# Talks to the local privsvc daemon over /run/tracenium/privsvc.sock.
# Never opens the network directly — every gRPC, REST, or system-
# privilege op flows through privsvc. Runs as user `tracenium`,
# which is in group `tracenium` (granting socket connect access).
Description=Tracenium Agent
Documentation=https://tracenium.com
# Hard requirement on privsvc: without the IPC socket the agent
# can't do anything useful. systemd will refuse to start the agent
# until privsvc has reached `active`, and will stop the agent if
# privsvc exits.
Requires=tracenium-privsvc.service
After=tracenium-privsvc.service network-online.target
Wants=network-online.target

# Restart-rate cap (must live in [Unit], not [Service] — see the
# note in tracenium-privsvc.service for the gotcha that motivated
# this placement).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=tracenium
Group=tracenium
# Inject GRPC_ENDPOINT / SERVER_BASE_URL / CERT_RENEWAL_BASE_URL /
# CHANNEL into process.env before exec — the agent's
# src/bootstrap/config.ts requires these (it dies early with
# "Missing required environment variable: GRPC_ENDPOINT"
# otherwise). Leading `-` lets systemd start the daemon even if
# the file's missing, so the failure mode is a clear app-level
# error rather than a unit refusing to start.
EnvironmentFile=-/etc/tracenium/agent.env
ExecStart=/usr/lib/tracenium/node /usr/lib/tracenium/agent/index.js
WorkingDirectory=/var/lib/tracenium

# Mirror of macOS launchd KeepAlive=true. The agent's outer error
# handlers absorb almost everything, so a process exit here means
# something genuinely catastrophic (uncaught exception in a startup
# hook, SQLite corruption, OOM kill) — restart and try again.
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tracenium-agent

# ── Hardening ──────────────────────────────────────────────────────
#
# ⚠️ NO agregar aquí directivas que creen un MOUNT NAMESPACE
#    (ProtectSystem, ProtectHome, PrivateTmp, ReadOnlyPaths,
#     ReadWritePaths, PrivateDevices, ProtectKernelTunables, …)
#    hasta que volvamos a Node 24. Ver abajo.
#
# Este archivo tenía ProtectSystem=strict + ReadWritePaths +
# ReadOnlyPaths + ProtectHome + PrivateTmp. Todas se quitaron el
# 2026-08-12 porque hacen que el daemon NO ARRANQUE en Ubuntu 24.04.
#
# Diagnóstico (server.certusws.com, Ubuntu 24.04.4, kernel 6.8,
# systemd 255), con strace dentro del namespace:
#
#     fstat(0, ...) = -1 EACCES (Permission denied)
#     write(2, "----- Native stack trace -----")
#     tgkill(...) SIGABRT
#
# Node hace fstat() sobre stdin al inicializar; dentro de un mount
# namespace el LSM (AppArmor) se lo deniega y Node 22.22.3 aborta en
# node::Start SIN imprimir mensaje de error — de ahí que el journal
# solo mostrara un stack nativo sin causa. Verificado por bisección:
#   * cualquier directiva de namespace  → ABRT
#   * NoNewPrivileges=true              → OK
#   * User/Group=tracenium              → OK
#   * StandardInput=null                → NO ayuda (no es el fd, es
#                                          el fstat el denegado)
#   * el MISMO binario con Node 24.10.0 → OK con PrivateTmp=true
#
# Por qué no revertimos a Node 24 (que sería el fix "de verdad"):
# .nodeversion se fijó en 22.22.3 a propósito porque los prebuilds de
# `node-datachannel` (compilados contra Node 18) fastfailean al
# construir PeerConnection en Node 24 — volver a 24 rompería RCP en
# TODA la flota, Windows y macOS incluidos. Un servidor Linux caído no
# justifica romper control remoto en todas partes.
#
# REVISAR cuando node-datachannel publique prebuilds para Node 24 (o
# lo compilemos desde fuente): ahí se sube .nodeversion y se restaura
# este bloque tal cual estaba.
#
# Lo que SÍ conservamos (probado que no dispara el abort): la
# separación de privilegios por usuario, NoNewPrivileges, y los
# permisos del socket/RuntimeDirectory que pone privsvc. La pérdida
# real es el aislamiento de filesystem, no el modelo de privilegios.

# Block privilege escalation. The tracenium user already has no
# sudo entry but this is belt-and-braces against a future packaging
# bug that accidentally adds it.
NoNewPrivileges=true

# Reach the privsvc socket and talk to api.tracenium.com /
# grpc.tracenium.com (REST + gRPC). The bind socket itself lives
# at /run/tracenium/privsvc.sock — the RuntimeDirectory= in the
# privsvc unit creates the dir 0750 root:tracenium, which we can
# traverse because the agent is in the tracenium group.

[Install]
WantedBy=multi-user.target
