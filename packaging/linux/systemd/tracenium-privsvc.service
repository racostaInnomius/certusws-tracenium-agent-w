[Unit]
# Tracenium PrivSvc — root-privileged broker for the agent.
#
# Owns: gRPC mTLS bridge to backend, cert lifecycle, patch install,
# system-posture queries that need root. The agent process talks to
# this daemon over a Unix socket at /run/tracenium/privsvc.sock and
# never opens those privileges itself.
Description=Tracenium PrivSvc (privileged broker)
Documentation=https://tracenium.com
# After network-online ensures DNS works at first connect; gRPC
# bridge needs to resolve grpc.tracenium.com.
After=network-online.target
Wants=network-online.target

# Cap restart rate so a permanent failure mode (corrupt cert,
# missing proto, etc.) doesn't drown journald. 5 restarts in 60s
# before systemd starts ignoring the unit; a human on-call has to
# step in. NOTE: these MUST live in [Unit], not [Service]; a
# previous version mistakenly put them under [Service] which made
# systemd warn `Unknown key name 'StartLimitIntervalSec' in
# section 'Service', ignoring.` and lose the rate limit.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Runs as root by design — this daemon's whole purpose is to hold
# the privileges the agent intentionally drops. The Unix socket it
# exposes is locked to mode 0660 root:tracenium so only the agent
# (which runs as the `tracenium` user, member of group `tracenium`)
# can connect.
User=root
# Group=tracenium (NOT root) is intentional and load-bearing:
#
# RuntimeDirectory=tracenium below creates /run/tracenium with the
# unit's User+Group as owner. With Group=root the dir would be
# `0750 root:root`, which the agent (user `tracenium`, NOT in
# group `root`) cannot traverse — it would fail to connect to
# privsvc.sock with "PrivSvc pipe not ready within timeout" even
# though the socket itself is `0660 root:tracenium`.
#
# Setting Group=tracenium makes the dir `0750 root:tracenium`,
# letting the agent traverse it. The privsvc process still runs
# with effective uid 0 (root) because User=root — Group= only
# changes the primary gid for filesystem operations, not the
# capability set.
#
# Side-effect: files created by privsvc with no explicit chmod end
# up group=tracenium. Every cert/data file the privsvc writes goes
# through explicit `chown` calls (see crypto-store.ts handleInstallCert
# and server.ts socket setup), so this default doesn't accidentally
# loosen any private files. Sockets are explicitly chowned to
# root:tracenium via lookupSocketGid in server.ts; that's now a
# no-op (already correct group) but harmless.
Group=tracenium
# Inject GRPC_ENDPOINT / SERVER_BASE_URL / CERT_RENEWAL_BASE_URL /
# CHANNEL into process.env before exec. Leading `-` makes this
# graceful — if /etc/tracenium/agent.env is missing (broken install,
# operator wiped it), systemd starts the daemon anyway and the
# agent's own config layer surfaces the missing-var error in the
# log instead of systemd refusing to start at all.
EnvironmentFile=-/etc/tracenium/agent.env
ExecStart=/usr/lib/tracenium/node /usr/lib/tracenium/privsvc/index.js

# RuntimeDirectory creates /run/tracenium with mode 0750 owned
# root:tracenium at start, and tears it down on stop. This is
# where privsvc.sock lives; cleaned by systemd so a crashed daemon
# can never leave a stale socket behind. The mode lets the
# `tracenium` group traverse and connect to children.
RuntimeDirectory=tracenium
RuntimeDirectoryMode=0750

# Restart=always is the Linux equivalent of macOS launchd's
# KeepAlive=true. The privsvc circuit breaker (Patches C+E+I in
# grpc-bridge.ts) deliberately calls process.exit(1) when reconnect
# attempts have been failing for >5 min — without Restart=always
# the daemon would just stop. RestartSec=5 is enough delay to let
# the kernel close FDs cleanly without flooding the system on a
# pathological crashloop.
Restart=always
RestartSec=5

# Logs go to journald (StandardOutput=journal) — operator's first
# stop on incidents (`journalctl -u tracenium-privsvc -f`). The
# daemon ALSO writes /var/log/tracenium/tracenium-privsvc-linux.log
# directly via fs.appendFileSync (see logger.ts) — that's the
# durable record that survives `journalctl --rotate`.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tracenium-privsvc

# Hardening — defense in depth, not the primary boundary. Anything
# that breaks the daemon's actual job (network access for gRPC,
# /etc/tracenium/certs reads, /var/lib/tracenium writes, dpkg/dnf
# spawns, journald writes) gets explicit allowlist. Anything not
# listed is denied.
#
# We deliberately do NOT set ProtectSystem=strict or
# ProtectHome=true here — the privsvc legitimately needs to write
# to /etc/tracenium/certs (cert install/renew), /var/lib/tracenium
# (state), /var/log/tracenium (logs), and /run/tracenium (socket).
# A future Phase 10 will tighten these once we've measured what
# patch.install / sdp.install actually touch in production.
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
