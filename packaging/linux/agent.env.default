# /etc/tracenium/agent.env
#
# Tracenium agent + privsvc environment. systemd loads this file
# via EnvironmentFile= in tracenium-{agent,privsvc}.service before
# spawning the daemon, so every variable here lands in process.env
# at boot.
#
# Edit and `sudo systemctl restart tracenium-privsvc tracenium-agent`
# to apply changes. The .deb marks this file as `config|noreplace`,
# so dpkg/rpm preserve operator edits across upgrades.

# gRPC endpoint. Host without port defaults to :443 (corporate
# firewalls already permit 443 outbound — avoids change-control for
# custom ports like :50051). Operators on the legacy :50051 stack
# can override here:
#   GRPC_ENDPOINT=grpc.tracenium.com:50051
GRPC_ENDPOINT=grpc.tracenium.com

# REST API base — enrollment, cert renewal, agent metadata, software
# delivery downloads.
SERVER_BASE_URL=https://api.tracenium.com

# Cert renewal base. Same as SERVER_BASE_URL by default; only override
# if you've split the cert API onto a different host.
CERT_RENEWAL_BASE_URL=https://api.tracenium.com

# Update channel: stable / beta / pilot. Determines which agent
# version stream the OTA update task pulls from.
CHANNEL=stable
