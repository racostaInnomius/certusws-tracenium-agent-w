# packaging/linux/nfpm.yaml.tmpl
#
# Template consumed by build-linux-pkg.sh. Tokens substituted at
# build time (the script does sed-based replacement):
#
#   __VERSION__       semver from package.json (or env override)
#   __ARCH__          "amd64" / "arm64" — matches deb naming
#   __BUILD_DIR__     absolute path to the staged bundle layout
#                     (typically <repo>/build/linux/pkg-root)
#   __REPO_ROOT__     absolute path to the agent repo, for refs to
#                     packaging/linux/{systemd,scripts}/* that live
#                     outside the staged bundle
#
# We use __TOKEN__ delimiters instead of ${TOKEN} to keep the
# template free of shell-syntax sigils that bash/envsubst could
# accidentally interpret if a future maintainer pipes this through
# a different substitution tool.
#
# Why nfpm: produces .deb and .rpm from one declaration. The packaging
# logic (preinst/postinst/prerm/postrm hooks, systemd units, file
# perms) is identical between the two formats — keeping a single
# source of truth means we never have a postinstall.sh that works on
# Ubuntu and silently fails on Rocky.
#
# nfpm docs: https://nfpm.goreleaser.com/
name: tracenium-agent
arch: __ARCH__
platform: linux
version: __VERSION__
# `release: 1` adds the suffix "-1" on .rpm ("tracenium-agent-1.1.18-1.x86_64.rpm")
# and is ignored by .deb. Bump this on a re-package of the same
# upstream version (we never expect to do that, but it's how rpm
# distros conventionally handle "we re-spun the same source").
release: 1
section: admin
priority: optional

maintainer: Certus <support@certusitm.com>
description: |
  Tracenium agent — collects hardware/software inventory, security
  posture and patch status from the host and reports back to the
  Tracenium control plane. Runs as a privileged broker daemon
  (tracenium-privsvc) plus an unprivileged collector (tracenium-agent)
  that talks to it over a Unix socket.
vendor: Certus
homepage: https://tracenium.com
license: Proprietary

# Replaces / Conflicts / Provides — used during upgrades. The agent
# shipped under different package names in early-life experimental
# builds; if you ever need to coexist or supersede those, list them
# here. For a clean v1 release the field is empty.
replaces: []
conflicts: []
provides:
  - tracenium-agent

# ── Dependencies ──────────────────────────────────────────────────
# Listed in the format-specific overrides below, since dpkg and dnf
# use different package names for the same thing (e.g. systemd is
# `systemd` on Debian, but the `systemd` rpm name maps to a slightly
# different binary set on RHEL — both ship systemctl, both ship the
# /lib/systemd path; we only require the systemctl binary at install
# time, declared via `dependencies`).
#
# We deliberately don't depend on `nodejs` — we ship our own node
# binary in /usr/lib/tracenium/node so the customer's distro can
# carry whatever node version it prefers without ABI mismatch
# against the better-sqlite3 native module.
depends:
  - openssl

deb:
  fields:
    Bugs: https://tracenium.com/support
  triggers:
    interest_noawait:
      - /lib/systemd/systemd

rpm:
  group: Applications/System
  compression: zstd
  # `summary` is the rpm equivalent of debian's first line of
  # description. Keep it short — RHEL's `dnf info` truncates after
  # ~80 chars.
  summary: Tracenium agent — inventory, compliance, patch management

# ── Contents — the file/dir layout this package produces ──────────
# nfpm copies these into the .deb/.rpm tree. We use absolute paths
# everywhere so the package can be built from any cwd — relative
# paths in `src` would be resolved against nfpm's process cwd, and
# we'd rather not depend on the build script's `cd` invariant.
contents:
  # Bundled Node runtime — same major version as the macOS bundle.
  # Cross-distro compatibility is the reason we ship our own:
  # better-sqlite3 has ABI-locked native bindings, and the customer's
  # /usr/bin/node could be anything from 12 to 22.
  - src: __BUILD_DIR__/node
    dst: /usr/lib/tracenium/node
    file_info:
      mode: 0755
      owner: root
      group: root

  # Privsvc bundle — esbuild-bundled JS produced by build-linux-pkg.sh.
  - src: __BUILD_DIR__/privsvc/index.js
    dst: /usr/lib/tracenium/privsvc/index.js
    file_info:
      mode: 0644
      owner: root
      group: root

  # Agent bundle — same.
  - src: __BUILD_DIR__/agent/index.js
    dst: /usr/lib/tracenium/agent/index.js
    file_info:
      mode: 0644
      owner: root
      group: root

  # Native node module: better-sqlite3 (rebuilt against bundled node
  # ABI). The agent's outbox.db requires this — pure-JS sqlite would
  # be 100x slower on the FACTS write path. We ship the entire
  # better-sqlite3 npm package (not just the .node binary) so its
  # main entry can require its own deps.
  - src: __BUILD_DIR__/agent/node_modules
    dst: /usr/lib/tracenium/agent/node_modules
    file_info:
      mode: 0644
      owner: root
      group: root

  # Proto file. grpc-bridge.ts loads it at startup via
  # protoLoader.loadSync(). The Phase 2 path resolver tries
  # __dirname/../proto/... first — that's where we put it.
  - src: __BUILD_DIR__/proto/controlplane.proto
    dst: /usr/lib/tracenium/proto/controlplane.proto
    file_info:
      mode: 0644
      owner: root
      group: root

  # Bundled root CA. crypto-store.ts merges this into the active
  # CA bundle on every grpc.connect — a renewal that updates the
  # issuing CA without redeploying the agent still chains to a
  # known root.
  - src: __BUILD_DIR__/assets/root-ca.crt
    dst: /var/lib/tracenium/assets/root-ca.crt
    file_info:
      mode: 0644
      owner: tracenium
      group: tracenium

  # systemd units — installed under /lib/systemd/system/ which is
  # a symlink to /usr/lib/systemd/system/ on every modern distro.
  # nfpm sets mode 0644 by default for these. Sourced directly from
  # the repo via __REPO_ROOT__ — no need to copy them into the
  # staging dir first.
  - src: __REPO_ROOT__/packaging/linux/systemd/tracenium-privsvc.service
    dst: /lib/systemd/system/tracenium-privsvc.service
    file_info:
      mode: 0644
  - src: __REPO_ROOT__/packaging/linux/systemd/tracenium-agent.service
    dst: /lib/systemd/system/tracenium-agent.service
    file_info:
      mode: 0644

  # ── Empty directories created up front ─────────────────────────
  # nfpm creates these with the requested perms. postinstall.sh
  # re-applies ownership in case the dpkg/rpm extractor reset
  # mode/owner.
  - dst: /etc/tracenium
    type: dir
    file_info:
      mode: 0755
      owner: root
      group: root
  - dst: /etc/tracenium/certs
    type: dir
    file_info:
      mode: 0750
      owner: root
      group: tracenium
  - dst: /var/lib/tracenium
    type: dir
    file_info:
      mode: 0750
      owner: tracenium
      group: tracenium
  - dst: /var/log/tracenium
    type: dir
    file_info:
      mode: 0750
      owner: tracenium
      group: tracenium

  # ── Config file — marked so package manager preserves operator
  #    edits across upgrades ────────────────────────────────────────
  # /etc/tracenium/agent.env holds GRPC_ENDPOINT, SERVER_BASE_URL,
  # CERT_RENEWAL_BASE_URL, CHANNEL. Loaded by both systemd units via
  # EnvironmentFile=. dotenv format (KEY=VALUE per line) — what
  # systemd parses natively AND what dotenv.config() in the agent
  # bootstrap reads if PWD is set to the dir containing it.
  #
  # Operators routinely tweak these (corporate proxy, alternate
  # endpoints), and we don't want an upgrade to silently overwrite
  # their changes. nfpm's `type: config` flag makes dpkg prompt +
  # rpm save .rpmsave on conflict.
  - src: __REPO_ROOT__/packaging/linux/agent.env.default
    dst: /etc/tracenium/agent.env
    type: config|noreplace
    file_info:
      mode: 0640
      owner: root
      group: tracenium

  # ── Phase 10 — hardening + ops ──────────────────────────────────
  # AppArmor profile (Debian/Ubuntu). RHEL hosts lack the
  # apparmor_parser binary; postinstall.sh handles that gracefully
  # by skipping the profile load — the file is still present on
  # disk but inert.
  - src: __REPO_ROOT__/packaging/linux/apparmor/usr.lib.tracenium.privsvc
    dst: /etc/apparmor.d/usr.lib.tracenium.privsvc
    file_info:
      mode: 0644
      owner: root
      group: root

  # SELinux module sources (RHEL-family). The .te + .fc are
  # compiled to .pp at install time by postinstall.sh via
  # `make -f /usr/share/selinux/devel/Makefile tracenium.pp`,
  # then loaded with `semodule -i tracenium.pp`. Debian hosts
  # without SELinux dev pkgs skip this step silently.
  - src: __REPO_ROOT__/packaging/linux/selinux/tracenium.te
    dst: /usr/share/tracenium/selinux/tracenium.te
    file_info:
      mode: 0644
      owner: root
      group: root
  - src: __REPO_ROOT__/packaging/linux/selinux/tracenium.fc
    dst: /usr/share/tracenium/selinux/tracenium.fc
    file_info:
      mode: 0644
      owner: root
      group: root

  # logrotate config — daily, keep 14 days compressed. Both
  # Debian and RHEL include logrotate by default (cron-driven on
  # both); the file just needs to be in /etc/logrotate.d/ and
  # the next daily run picks it up.
  - src: __REPO_ROOT__/packaging/linux/logrotate/tracenium
    dst: /etc/logrotate.d/tracenium
    file_info:
      mode: 0644
      owner: root
      group: root

# ── Maintainer scripts ────────────────────────────────────────────
# nfpm wires each into both .deb and .rpm hooks:
#   preinstall  → debian preinst,  rpm %pre
#   postinstall → debian postinst, rpm %post
#   preremove   → debian prerm,    rpm %preun
#   postremove  → debian postrm,   rpm %postun
scripts:
  preinstall: __REPO_ROOT__/packaging/linux/scripts/preinstall.sh
  postinstall: __REPO_ROOT__/packaging/linux/scripts/postinstall.sh
  preremove: __REPO_ROOT__/packaging/linux/scripts/preremove.sh
  postremove: __REPO_ROOT__/packaging/linux/scripts/postremove.sh
