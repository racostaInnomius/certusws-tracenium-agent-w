# /etc/apparmor.d/usr.lib.tracenium.privsvc
#
# AppArmor profile for the Tracenium privsvc daemon. Sits on top of
# the systemd unit's hardening (User=root, RuntimeDirectory=, etc.)
# as a kernel-enforced confinement layer — even if the daemon is
# compromised at runtime, AppArmor prevents it from reading
# /etc/shadow, writing /boot, executing /bin/sh, etc.
#
# Profile name = path to the binary's invoker. Since the daemon
# launches as `node /usr/lib/tracenium/privsvc/index.js`, AppArmor
# applies this profile based on the FIRST argv. We label the profile
# by the canonical install path under /usr/lib/tracenium.
#
# Mode: COMPLAIN (ver el bloque de flags mas abajo para el porque).
# Registra lo que denegaria sin bloquear nada. Para ver que recogeria
# en este host:
#   sudo journalctl -k | grep 'apparmor="ALLOWED"' | grep tracenium
#
# ⚠️ `aa-complain` / `aa-enforce` vienen en el paquete apparmor-utils,
# que NO esta instalado en todas partes (Ubuntu 26.04 minimal no lo
# trae). El modo se cambia editando los flags y recargando; ver el
# bloque de flags.
#
# Loading: postinstall.sh corre `apparmor_parser -r` si el parser esta
# presente. Ojo: aunque no lo hiciera, `apparmor.service` viene enabled
# en Debian/Ubuntu y su ExecStart hace `reload`, que carga TODO lo que
# haya en /etc/apparmor.d/ — o sea que el fichero se aplica desde el
# primer reboot lo quiera el instalador o no.

#include <tunables/global>

# flags=(attach_disconnected): sin esto, `aa-status` —que es una de las
# comprobaciones de compliance del SCP— falla al abrir
# /sys/kernel/security/apparmor/profiles con "Failed name lookup - disconnected
# path". securityfs queda fuera del arbol que el perfil puede resolver, asi que
# AppArmor ve un nombre suelto ("profiles") en vez de una ruta y lo rechaza
# aunque la regla exista. El flag reancla esos nombres a la raiz.
# flags=(complain): el perfil se ENVIA en modo permisivo. Registra todo lo que
# denegaria —con apparmor="ALLOWED" en el journal— pero no bloquea nada.
#
# El motivo es un historial, no una preferencia. Este allowlist ya congelo un
# host cuatro dias (le faltaba systemd-run y el arreglo viajaba dentro del
# update que el propio perfil bloqueaba) y dejo el remote shell de Linux
# inservible sin que nadie lo notara. Ambos fallos compartian forma: un hueco
# en el perfil se manifiesta como una funcion que desaparece en silencio, en
# una distro que no habiamos probado, semanas despues de escribir la regla.
#
# En complain esa clase de fallo deja de existir: el hueco se convierte en una
# linea de log en vez de una funcion rota. Recogemos denegaciones de la flota
# real —no solo del unico Ubuntu 26.04 que tenemos— y una version posterior
# pasa a enforce con datos en vez de con suposiciones.
#
# ⚠️ LO QUE HAY QUE MIRAR ANTES DE ENDURECER (actualizado 2026-08-19)
#
# En complain el kernel SI permite las transiciones de dominio (Ux/Cx) que
# `no_new_privs` veta en enforce. O sea que cada regla `Ux` de este archivo
# funciona hoy y puede dejar de funcionar al cambiar el flag — sin que nada
# lo anuncie salvo un `apparmor="DENIED" ... info="no new privs"`.
#
# El reparto es por unidad, no por regla:
#   tracenium-privsvc  NoNewPrivileges=no   -> sus `Ux` funcionan tambien en
#                                              enforce (medido: bash por Ux sin
#                                              NNP devuelve SHELL_OK en enforce)
#   tracenium-agent    NoNewPrivileges=yes  -> sus `Ux` son letra muerta
#
# El remote shell YA NO depende de esto: el pty se mudo a privsvc (commit
# 4a9d8e0), que no tiene NNP. Un aviso anterior decia lo contrario y se ha
# corregido aqui — no volver a decidir con esa version.
#
# Lo que SI se rompe al endurecer son los gestores que invoca el AGENTE y
# siguen marcados `Ux`:
#
#   apt-mark   dnf5   dnf   rpm
#
# Es el inventario de software en Debian/RHEL/Fedora, y fallaria en SILENCIO:
# lista de paquetes vacia, sin error, igual que paso con snap. El remedio es el
# mismo que se le aplico a snap —pasarlos a `ix` y concederles lo que
# necesiten— o asumir conscientemente la perdida en esas distros.
#
# Decision tomada el 2026-08-19: NO se toca todavia. El perfil esta en complain
# y no bloquea nada, asi que esto se resuelve al endurecer y con los datos de
# `apparmor="ALLOWED"` que la flota vaya dejando, en vez de a ciegas contra el
# unico Ubuntu 26.04 que tenemos.
#
# Para endurecer, una vez validado en tu distro:
#   sudo sed -i 's/,complain//' /etc/apparmor.d/usr.lib.tracenium.privsvc
#   sudo apparmor_parser -r /etc/apparmor.d/usr.lib.tracenium.privsvc
profile tracenium-privsvc /usr/lib/tracenium/node flags=(attach_disconnected,complain) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>

  # ── Self ─────────────────────────────────────────────────────────
  # The Node binary we ship + the JS bundles it loads. Read+execute
  # only — no rewriting our own binary at runtime.
  /usr/lib/tracenium/node                          rmix,
  /usr/lib/tracenium/**.js                          r,
  /usr/lib/tracenium/**.json                        r,
  /usr/lib/tracenium/proto/controlplane.proto       r,

  # better-sqlite3 native binding. node loads it via dlopen.
  /usr/lib/tracenium/agent/node_modules/**          mr,
  /usr/lib/tracenium/agent/node_modules/**.node     mr,

  # ── State ────────────────────────────────────────────────────────
  /var/lib/tracenium/                               rw,
  /var/lib/tracenium/**                             rwk,    # k = file locks (sqlite WAL)
  /var/log/tracenium/                               rw,
  /var/log/tracenium/**                             rwk,
  /run/tracenium/                                   rw,
  # `**` ya cubre los sockets rcp-<token>.sock del shell remoto: privsvc los
  # crea ahi y el agente se conecta. El directorio lo hace systemd 0750
  # root:tracenium (RuntimeDirectory), asi que ningun otro usuario del sistema
  # puede siquiera atravesarlo — esa es la frontera real de un socket que ES
  # una shell de root.
  /run/tracenium/**                                 rw,

  # ── Config ───────────────────────────────────────────────────────
  # `w` sobre los directorios ademas de los ficheros: la renovacion de certs
  # hace chmod, que apparmor contabiliza como escritura sobre el directorio.
  # Sin esto se veian deniegos de chmod sobre /etc/tracenium/ y /certs/.
  /etc/tracenium/                                   rw,
  /etc/tracenium/agent.json                         r,
  /etc/tracenium/certs/                             rw,
  /etc/tracenium/certs/*                            rw,    # cert renewal writes back

  # ── System inventory + posture inputs ────────────────────────────
  # Read-only access to the bits Phase 5 SCP and Phase 3 AMP
  # collectors need. Each path explicit so a future code change that
  # adds a new read target shows up as an AppArmor denial in the
  # log instead of silently working — forcing the maintainer to
  # update this profile deliberately.
  /etc/os-release                                   r,
  /etc/group                                        r,
  /etc/passwd                                       r,
  /etc/login.defs                                   r,
  /etc/ssh/sshd_config                              r,
  /etc/ssh/sshd_config.d/                           r,
  /etc/ssh/sshd_config.d/*                          rw,    # Phase 8 drop-in writes
  /etc/ssh/ssh_host_*_key                           r,
  /etc/ssh/ssh_host_*_key.pub                       r,
  /sys/kernel/security/apparmor/profiles            r,
  /sys/class/dmi/id/                                r,
  /sys/class/dmi/id/**                              r,
  # SCP screen-lock (Sprint 4): system dconf policy fragments + locks.
  # Read-only; we never invoke gsettings/dconf (root's profile ≠ user's).
  /etc/dconf/                                       r,
  /etc/dconf/**                                     r,
  # SCP disk-encryption (Sprint 4): lsblk walks the block tree via sysfs
  # and udev's device DB. Without these reads lsblk still EXECS fine but
  # returns an empty tree — the same "silently empty" failure the snap/
  # flatpak rules below document. Read-only, no device nodes opened.
  /sys/block/                                       r,
  /sys/block/**                                     r,
  /sys/dev/block/                                   r,
  /sys/dev/block/**                                 r,
  /sys/devices/**/block/**                          r,
  /sys/devices/virtual/block/**                     r,
  /run/udev/data/                                   r,
  /run/udev/data/*                                  r,
  /proc/swaps                                       r,
  # apt lee su configuracion antes de listar actualizaciones. Sin esto el
  # escaneo de parches fallaba con "Unable to read /etc/apt/apt.conf.d/".
  /etc/apt/                                         r,
  /etc/apt/**                                       r,
  # version_signature: deteccion de kernel en Ubuntu.
  /proc/version_signature                           r,
  /proc/cpuinfo                                     r,
  /proc/meminfo                                     r,
  /proc/version                                     r,
  /proc/uptime                                      r,
  /proc/sys/kernel/hostname                         r,
  /proc/[0-9]*/                                     r,
  /proc/[0-9]*/cmdline                              r,
  /proc/[0-9]*/stat                                 r,
  /proc/[0-9]*/status                               r,
  # cgroup: deteccion de contenedor/virtualizacion. Cada proceso lee el SUYO.
  # Sin esta linea, ademas del `open` denegado se disparaba un `capable
  # dac_override` inmediatamente despues — el kernel reintentando por la via
  # privilegiada lo que AppArmor acababa de negar. Conceder la RUTA elimina
  # las dos; conceder la capability habria tapado el sintoma abriendo un
  # bypass de permisos para todo el perfil.
  /proc/[0-9]*/cgroup                               r,
  # mounts y net/** son vistas POR-PROCESO de informacion global (tabla de
  # montajes, contadores de red). No son secretos y el inventario los lee.
  /proc/[0-9]*/mounts                               r,
  /proc/[0-9]*/mountinfo                            r,
  /proc/[0-9]*/net/**                               r,
  /proc/                                            r,
  /proc/swaps                                       r,
  # /proc/sys/{net,kernel}: NO es relleno de inventario — son las fuentes de
  # los checks de compliance del SCP (rp_filter, accept_redirects,
  # tcp_syncookies, log_martians, randomize_va_space/ASLR). Denegadas, esos
  # controles no fallaban: se evaluaban sobre nada.
  /proc/sys/net/**                                  r,
  /proc/sys/kernel/**                               r,
  # linux-probes.ts: sysctl bajo fs/vm/etc, módulos cargados y el árbol de
  # módulos del kernel que modprobe -n necesita para resolver un nombre.
  /proc/sys/**                                      r,
  /proc/modules                                     r,
  /usr/lib/modules/                                 r,
  /usr/lib/modules/**                               r,
  /lib/modules/                                     r,
  /lib/modules/**                                   r,
  /var/log/                                         r,
  /var/log/audit/                                   r,

  # Base de datos de dpkg: es lo que lee dpkg-query para el inventario de
  # software en Debian/Ubuntu.
  /var/lib/dpkg/**                                  r,

  # Base de datos de udev y symlinks de disco: lsblk y `ls /dev/disk/by-id`
  # los necesitan para dar identidad a los discos (modelo, serie, WWN).
  /run/udev/data/**                                 r,
  /dev/disk/**                                      r,
  # snap y flatpak corriendo CONFINADOS (ix) necesitan sus propios datos:
  # snap monta squashfs bajo /snap y habla con snapd por su socket.
  # `mr`, no solo `r`: el snap real se enlaza contra la libc que vive DENTRO
  # de la revision montada, y mapear una libreria ejecutable exige `m`. Con
  # solo `r` el binario arranca y muere con "libc.so.6: failed to map segment
  # from shared object" — otro mensaje que no menciona AppArmor.
  /snap/**                                          mr,
  /var/lib/snapd/**                                 r,
  /run/snapd.socket                                 rw,
  /var/lib/flatpak/**                               r,

  # aa-status enumerando perfiles: con attach_disconnected la ruta suelta
  # "profiles" de securityfs se reancla a la raiz y aparece asi.
  /profiles/                                        r,
  /profiles/**                                      r,

  # Sesiones interactivas (w/who) y datos sueltos de /proc que piden lscpu,
  # `w` y los probes de carga.
  /run/systemd/sessions/                            r,
  /run/systemd/sessions/**                          r,
  /proc/loadavg                                     r,
  /proc/tty/drivers                                 r,
  /proc/cmdline                                     r,
  /proc/[0-9]*/loginuid                             r,
  /proc/[0-9]*/fd/                                  r,
  # attr/current: la etiqueta de confinamiento de cada proceso. Es como
  # aa-status cuenta cuantos procesos corren confinados — otro insumo del SCP.
  /proc/[0-9]*/attr/current                         r,
  /proc/[0-9]*/attr/apparmor/current                r,
  /run/modprobe.d/                                  r,
  /run/modprobe.d/**                                r,
  /opt/                                             r,
  /usr/local/lib/python3*/dist-packages/            r,

  # LEER (no ejecutar) binarios del sistema. Varios probes hacen el equivalente
  # de un `which`: abren la ruta para ver si la herramienta existe. Sin esto se
  # veian deniegos de `open` sobre binarios que ya tenian permiso de `x` — son
  # permisos distintos. `r` sobre un binario no permite ejecutarlo: eso lo sigue
  # gobernando la lista de execs de mas abajo.
  # Los DIRECTORIOS, ademas de su contenido: listar /usr/sbin es como varios
  # probes buscan una herramienta antes de invocarla.
  /usr/bin/                                         r,
  /usr/sbin/                                        r,
  /bin/                                             r,
  /sbin/                                            r,
  /usr/bin/*                                        r,
  /usr/sbin/*                                       r,
  /bin/*                                            r,
  /sbin/*                                           r,

  # kmsg: buffer del kernel, lo lee dmesg para datos de hardware.
  /dev/kmsg                                         r,
  # utab: montajes de userspace, complementa /proc/self/mountinfo.
  /run/mount/utab                                   r,

  # ── Superficies de solo-LECTURA del sistema ──────────────────────
  #
  # Enumerar estas rutas una por una no converge, y lo comprobamos: cada
  # ronda de reglas destapaba la siguiente capa (/etc/lsb-release, luego
  # /etc/network/interfaces, luego los locales de uutils, luego memory.max
  # del cgroup...). No es un perfil incompleto, es la naturaleza del
  # componente: leer la configuracion y el estado del sistema ES lo que hace
  # un agente de inventario. Y cada hueco nuevo se manifiesta como un campo
  # vacio en el portal, nunca como un error.
  #
  # POR QUE ES SEGURO AMPLIAR AQUI, y no en otro sitio: en AppArmor las
  # reglas `deny` GANAN sobre las `allow`, sin importar el orden. El bloque
  # de denies del final de este archivo —/etc/shadow, /etc/sudoers,
  # /home/**, /root/.ssh/**— sigue en pie tal cual. La garantia que promete
  # la cabecera ("aunque el daemon sea comprometido, no puede leer
  # /etc/shadow") la sostienen esos denies, no la ausencia de un allow.
  # Verificado en el endpoint, no deducido: con /etc/** concedido, leer
  # /etc/shadow bajo el perfil sigue dando "Permission denied".
  #
  # Lo que de verdad contiene a este proceso permanece intacto: no puede
  # ESCRIBIR fuera de sus rutas, no puede EJECUTAR nada que no este en la
  # lista de arriba, y no tiene capabilities.
  #
  # /proc NO se amplia a proposito: /proc/[0-9]*/environ filtraria variables
  # de entorno de otros procesos (credenciales incluidas) y /proc/kcore es
  # la memoria del kernel. Las rutas de /proc siguen enumeradas arriba.
  /etc/                                             r,
  /etc/**                                           r,
  /sys/**                                           r,
  /usr/share/**                                     r,

  # /var/run is a symlink to /run on every modern systemd distro.
  # If a customer's host has it as a real dir we still cover it.
  /var/run/tracenium/                               rw,
  /var/run/tracenium/**                             rw,

  # systemd-run se comunica con el gestor por este socket privado. Permitir
  # solo el exec no basta: la llamada falla igualmente.
  /run/systemd/private                              rw,

  # NO hay regla para /run/snapd.socket a proposito, aunque el journal se
  # llene de `DENIED operation="connect" name="/run/snapd.socket"`. Esa
  # denegacion es un sintoma de snap corriendo confinado, no la causa:
  # concederla sola no arregla nada porque snap falla antes, leyendo
  # /snap/snapd/current/**. La solucion esta abajo, en la seccion de execs —
  # snap va `Ux`, como el resto de los gestores de paquetes.

  # ── Subprocess execs ─────────────────────────────────────────────
  # Every binary the privsvc invokes via execFile in any phase.
  #
  # `Ux` (unconfined exec) para los gestores de paquetes y systemd-run, NO
  # `ix`. Con `ix` el hijo hereda ESTE perfil, y los postinst de un .deb hacen
  # de todo: ejecutan sh, cat, hostname, dmidecode, piden sys_admin y
  # dac_override. Medido en produccion el 2026-08-15: con `ix`, dpkg arrancaba
  # y sus postinst morian a deniegos, dejando el paquete a medio configurar.
  # Confinar a apt/dnf/dpkg es una superficie enorme y fuera de alcance.
  #
  # El resto sigue con `ix`: son lecturas acotadas que no lanzan subprocesos.
  /usr/bin/curl                                     ix,
  /usr/bin/openssl                                  ix,
  /usr/bin/dpkg                                     Ux,
  /usr/bin/dpkg-query                               ix,
  /usr/bin/apt                                      Ux,
  /usr/bin/apt-get                                  Ux,
  /usr/bin/dnf                                      Ux,
  /usr/bin/yum                                      Ux,
  /usr/bin/rpm                                      Ux,
  # Los cuatro de abajo los destapo el test de cobertura de exec
  # (test/packaging/apparmor-exec-coverage.test.ts): se invocaban desde el
  # codigo sin regla, asi que en el endpoint fallaban con EACCES en silencio.
  #
  # Todos van Ux por el mismo motivo que sus hermanos de arriba: son gestores
  # de paquetes (o los envuelven) y lanzan subprocesos propios. Con `ix`
  # heredarian este perfil y moririan a deniegos por dentro.
  #   apt-mark  — `showmanual`, script Python que usa las libs de apt
  #   dnf5      — reemplazo de dnf en Fedora 41+
  #   zypper    — gestor de openSUSE
  #   dpkg-sig  — verifica la firma de un .deb; por dentro ejecuta gpg
  /usr/bin/apt-mark                                 Ux,
  /usr/bin/dnf5                                     Ux,
  /usr/bin/zypper                                   Ux,
  /usr/bin/dpkg-sig                                 Ux,
  # snap y flatpak eran los DOS UNICOS gestores de paquetes con `ix` en toda
  # esta lista, y esa inconsistencia los tenia rotos. Medido en SRVOC-MainAgent
  # (Ubuntu 26.04), `snap list` bajo el perfil:
  #
  #   cannot open snapd info file "/snap/snapd/current/usr/lib/snapd/info":
  #   permission denied
  #
  # El sintoma que se veia en el journal era otro —una tormenta de
  # `DENIED operation="connect" name="/run/snapd.socket"` cada 250ms— y invita
  # a "arreglarlo" añadiendo esa unica ruta. No basta: el socket es apenas el
  # segundo obstaculo. snap monta squashfs, lee /snap/**, habla con snapd y
  # reintenta en bucle en vez de fallar; perseguir sus rutas de una en una es
  # la misma superficie enorme que este archivo ya declaro fuera de alcance
  # para apt/dnf/dpkg.
  #
  # Consecuencia de tenerlos confinados: el inventario de snaps/flatpaks volvia
  # VACIO y sin error — el endpoint reportaba que no habia ninguno instalado,
  # que es peor que reportar un fallo.
  # ⚠️ ix, NO Ux, y el motivo es sutil: `tracenium-agent.service` corre con
  # NoNewPrivileges=yes, y el kernel PROHIBE la transicion Ux —salir del
  # confinamiento es una ganancia de privilegio— con
  #   apparmor="DENIED" ... info="no new privs" error=-1
  # Como este perfil confina tambien al agente, cualquier Ux que el AGENTE
  # necesite es letra muerta. Solo privsvc (NoNewPrivileges=no) puede usarlos.
  # El inventario de snaps/flatpaks lo hace el agente, asi que van ix y este
  # perfil concede lo que necesitan (abajo, /snap/** y el socket de snapd).
  /usr/bin/snap                                     ix,
  /usr/bin/flatpak                                  ix,
  # /usr/bin/snap es un shim: re-ejecuta el snap REAL que vive dentro de la
  # revision montada de snapd. Sin esta linea el shim arranca y muere con
  # `panic: permission denied`, que no menciona AppArmor por ningun lado.
  /snap/snapd/*/usr/bin/snap                        ix,
  /usr/bin/systemctl                                ix,
  # Fase 2 del cierre de brecha CIS (linux-probes.ts): `modprobe -n -v` sólo
  # simula (-n) — no carga nada — para saber si un módulo está neutralizado.
  /usr/sbin/modprobe                                ix,
  # systemd-run: lanza el dpkg del auto-update en un scope propio, para que
  # sobreviva al reinicio del servicio que provoca su propia instalacion.
  # Sin esta regla el spawn daba EACCES y el update NUNCA se ejecutaba.
  /usr/bin/systemd-run                              Ux,
  # dash: shell por defecto de Debian/Ubuntu; execFile con shell:true y los
  # postinst pasan por aqui.
  /usr/bin/dash                                     ix,
  /usr/bin/sh                                       ix,

  # ── RCP — helper del shell remoto privilegiado ───────────────────
  # privsvc lanza este JS con su propio node para abrir un pty como root
  # (ver privsvc/linux/src/rcp-pty.ts). `r` basta: no se ejecuta por si
  # mismo, se le pasa a node como argumento — por eso se instala 0644.
  /usr/lib/tracenium/privsvc/tracenium-rcp-pty      r,

  # ── RCP — captura de pantalla e indicador de sesion (ADR-0012) ───
  # Las dos cosas que privsvc tiene que poner en el escritorio del usuario
  # pasan por el mismo salto: `runuser -u <user> -- env DISPLAY=... helper`.
  #
  # Ux y no ix: el helper habla con el servidor X del usuario y necesita sus
  # sockets, sus fuentes y su cookie. Confinarlo bajo ESTE perfil —escrito
  # para un demonio sin cara— le negaria todo eso, y el sintoma seria una
  # captura en negro o un indicador que no aparece, sin mencionar AppArmor
  # por ningun lado.
  #
  # Ux es legitimo aqui porque quien lanza es privsvc, que corre con
  # NoNewPrivileges=no. El agente no podria (ver la nota de snap/flatpak
  # arriba), pero el agente no lanza esto.
  #
  # ⚠️ Sin estas lineas, al pasar el perfil a enforce se rompen a la vez la
  # comparticion de pantalla en Linux y —peor— el aviso de ADR-0012 que le
  # dice a la persona que le estan mirando. Hoy el perfil va en complain, asi
  # que esto solo se ve como apparmor="ALLOWED" en el log; se declara ahora
  # para que ese cambio no se lleve la funcion por delante.
  /usr/bin/runuser                                  Ux,
  /usr/bin/su                                       Ux,
  /bin/su                                           Ux,
  # `r` y no `x`: privsvc no los ejecuta, comprueba que existan antes de
  # pasarselos a runuser (fs.existsSync). Quien los ejecuta es runuser, ya
  # fuera de este perfil.
  /usr/lib/tracenium/privsvc/tracenium-screencap    r,
  /usr/lib/tracenium/privsvc/tracenium-indicator    r,

  # ── RCP remote shell ─────────────────────────────────────────────
  # ⚠️ Este perfil se ancla a /usr/lib/tracenium/node, que es el MISMO
  # binario con el que arranca el AgentCore (ExecStart=/usr/lib/tracenium/node
  # /usr/lib/tracenium/agent/index.js). O sea que un perfil escrito para el
  # privsvc confina también al agente. Sin las reglas de abajo, node-pty no
  # podía abrir un pty y remote shell moría con "pty_spawn_failed:
  # forkpty(3) failed" — un mensaje que no menciona AppArmor por ningún lado.
  #
  # Medido en el endpoint, mismo módulo y mismo usuario:
  #   /usr/lib/tracenium/node        (confinado)   -> forkpty(3) failed.
  #   copia del mismo node en /tmp   (sin confinar) -> OK pid 2797042
  #
  # El pty maestro y su esclavo. Es lo mínimo: sin esto no hay terminal.
  /dev/ptmx                                         rw,
  /dev/pts/*                                        rw,

  # Los shells interactivos que puede elegir pickShell(). Van como Ux
  # (SIN confinar) a propósito, y conviene entender el trato:
  #
  # Con `ix` el shell heredaría este perfil y el operador tendría una
  # terminal donde casi todo se deniega — un shell de soporte inservible
  # que además falla de formas desconcertantes. Con `Ux` el shell corre
  # de verdad, pero fuera de AppArmor.
  #
  # Lo que SIGUE conteniéndolo: el servicio corre como User=tracenium sin
  # privilegios, así que los permisos Unix son la frontera real; y por
  # arriba, el gate RBAC (ADMIN/OWNER) y el consentimiento del endpoint
  # deciden quién puede abrir la sesión siquiera.
  #
  # Si se quiere confinamiento dentro del shell remoto, la vía correcta NO
  # es cambiar esto a `ix`, sino un perfil hijo propio (`Cx -> rcp_shell`)
  # con su propio conjunto de reglas. Es más trabajo y una decisión de
  # postura de seguridad, no un detalle de empaquetado.
  /bin/bash                                         Ux,
  /usr/bin/bash                                     Ux,
  /bin/sh                                           Ux,
  /bin/zsh                                          Ux,
  /usr/bin/zsh                                      Ux,
  # who/logname: sesion interactiva, para el widget de soporte.
  /usr/bin/who                                      ix,
  /usr/bin/logname                                  ix,
  # whoami: mismo widget, en device-facts-builder. Faltaba.
  /usr/bin/whoami                                   ix,
  # ── Shell-outs de `systeminformation` ────────────────────────────
  # Estos NO los invoca nuestro codigo: los lanza la dependencia npm
  # `systeminformation` con `sh -c` al recolectar inventario de hardware. Por
  # eso el test de cobertura (test/packaging/apparmor-exec-coverage.test.ts)
  # no puede verlos — escanea literales de ruta en NUESTRAS fuentes. Salieron
  # observando denegaciones reales en SRVOC-MainAgent, no leyendo codigo.
  #
  # Lo que rompia tenerlos denegados: dmidecode da fabricante, modelo, serie y
  # BIOS; lsblk da los discos. Sin ellos el equipo se inventaria sin identidad
  # de hardware — y en silencio, porque un campo vacio no parece un fallo.
  #
  # Todos `ix`: son lectores acotados que no lanzan subprocesos. dmidecode ya
  # tiene su fuente permitida mas arriba (/sys/class/dmi/id/**).
  /usr/sbin/dmidecode                               ix,
  /usr/bin/lsblk                                    ix,
  /usr/bin/hostname                                 ix,
  /usr/bin/ip                                       ix,
  /usr/bin/grep                                     ix,
  /usr/bin/gawk                                     ix,
  /usr/bin/awk                                      ix,
  /usr/bin/sed                                      ix,
  /usr/bin/lscpu                                    ix,
  /usr/bin/lspci                                    ix,
  /usr/bin/dmesg                                    ix,
  /usr/bin/w                                        ix,
  /usr/bin/df                                       ix,
  # gnudf: en Ubuntu 26.04, con uutils como coreutils por defecto, el `df` de
  # GNU se conserva aparte con este nombre y es el que acaba invocandose.
  /usr/bin/gnudf                                    ix,
  # Hermanos del mismo grupo — inspeccion de solo lectura que `systeminformation`
  # elige segun lo que encuentre en el host. Listados por adelantado para no
  # descubrirlos de a uno en cada distro nueva, que es como llegamos hasta aqui.
  /usr/bin/free                                     ix,
  /usr/bin/nproc                                    ix,
  /usr/bin/getconf                                  ix,
  # getent: snap lo invoca para resolver el usuario al armar su autorizacion.
  /usr/bin/getent                                   ix,
  /usr/bin/findmnt                                  ix,
  /usr/bin/mount                                    ix,
  /usr/bin/ps                                       ix,
  /usr/bin/ss                                       ix,
  /usr/sbin/blkid                                   ix,
  /usr/sbin/sysctl                                  ix,
  # cat, y la razon del glob: Ubuntu 26.04 usa los coreutils de uutils (Rust),
  # asi que /usr/bin/cat es un symlink a /usr/lib/cargo/bin/coreutils/cat y
  # AppArmor resuelve al destino real — que es el que aparecia denegado. El
  # glob cubre a la familia entera en esas distros en vez de ir sumando
  # herramienta por herramienta cada vez que un probe use head, tail o wc.
  /usr/lib/cargo/bin/coreutils/*                    ix,
  /usr/bin/cat                                      ix,
  /bin/cat                                          ix,

  # testparm: vuelca la config efectiva de Samba para el check de compliance.
  # Lectura acotada, sin subprocesos -> ix basta.
  /usr/bin/testparm                                 ix,
  /usr/bin/journalctl                               ix,
  /usr/bin/firewall-cmd                             ix,
  /usr/bin/needs-restarting                         ix,
  /usr/bin/fuser                                    ix,
  /usr/bin/uname                                    ix,
  /usr/sbin/sshd                                    ix,
  /usr/sbin/getenforce                              ix,
  /usr/sbin/sestatus                                ix,
  /usr/sbin/aa-status                               ix,
  /usr/sbin/ufw                                     ix,
  /usr/sbin/iptables                                ix,
  /usr/sbin/nft                                     ix,
  /sbin/auditd                                      ix,
  /usr/sbin/auditd                                  ix,
  # lsblk: SCP disk-encryption evidence (Sprint 4). Read-only block-tree
  # walk; needs /sys/dev/block + /sys/block reads (below) and no children.
  /bin/lsblk                                        ix,
  /usr/bin/lsblk                                    ix,

  # ── Network ──────────────────────────────────────────────────────
  # Outbound IPv4/IPv6 TCP — gRPC to grpc.tracenium.com:443 + REST
  # to api.tracenium.com:443. AppArmor has no port granularity in
  # the legacy network rule shape we use here; egress to all ports
  # is what the kernel enforces for any unconfined process anyway.
  network inet stream,
  network inet6 stream,
  # Unix domain — IPC server bind/accept on /run/tracenium/privsvc.sock
  network unix stream,

  # ── Capabilities ─────────────────────────────────────────────────
  # Minimum set to do our job. systemd already drops everything not
  # listed here; AppArmor double-checks. Notable absences:
  #   * sys_module    — never load kernel modules
  #   * sys_admin     — never mount/unmount
  #   * sys_ptrace    — never attach to other processes
  #   * net_admin     — never reconfigure interfaces (firewall
  #                     remediation shells out to ufw/firewall-cmd
  #                     which run unconfined and have their own
  #                     net_admin)
  capability dac_read_search,    # read files we don't own (e.g. /etc/shadow not needed but /etc/group OK)
  capability fowner,             # chown the IPC socket to root:tracenium
  capability fsetid,             # preserve setgid bits across cert install
  capability chown,              # chown across rename for atomic file replace
  capability kill,                # send SIGTERM to subprocesses on timeout
  capability setuid,              # spawn unprivileged children if ever needed
  capability setgid,              # idem

  # ── Deny rules — explicit, to make policy intent obvious ─────────
  # ── Lo que se deja DENEGADO a proposito ──────────────────────────
  #
  # Tras cerrar todos los huecos de ruta y exec, el unico ruido que queda en
  # el journal son estas capabilities. NO se conceden:
  #
  #   dac_override  saltarse TODOS los permisos de fichero. Concederla anula
  #                 de un plumazo el bloque de denies de aqui abajo.
  #   sys_admin     practicamente equivalente a root; el "cajon de sastre"
  #                 del kernel.
  #   sys_ptrace    leer la memoria de otros procesos (y ptrace, igual).
  #   perfmon       contadores de rendimiento del kernel.
  #
  # Las pide `systeminformation` sondeando de mas, no codigo nuestro, y con
  # todas denegadas el inventario y el compliance salen COMPLETOS — verificado
  # en SRVOC-MainAgent con ciclos enteros sin una sola denegacion de fichero.
  # O sea: cuestan ruido de auditoria, no funcionalidad. Un agente de
  # inventario que necesitara saltarse los permisos de fichero para hacer su
  # trabajo seria un agente mal escrito.
  #
  # Se dejan AUDITADAS (denegacion implicita, no `deny` explicito) a
  # proposito: un `deny` silencia el log, y preferimos conservar la señal por
  # si algun dia una de estas sí corresponde a algo roto. Si el volumen
  # molesta, convertirlas en `deny` explicito las silencia sin conceder nada.
  #
  # Tambien queda denegado /usr/lib/update-notifier/apt_check.py: es el
  # contador de "actualizaciones pendientes" de Ubuntu que invoca
  # systeminformation. Necesitaria Python confinado dentro de este perfil, y
  # ese dato ya lo cubre el PMP con su propia implementacion.

  deny /boot/**                                     w,
  deny /etc/shadow                                  rw,
  deny /etc/sudoers                                 rw,
  deny /etc/sudoers.d/                              rw,
  deny /etc/sudoers.d/**                            rw,
  deny /home/**                                     rw,
  deny /root/.ssh/**                                rw,
  deny mount,
  deny umount,
}
