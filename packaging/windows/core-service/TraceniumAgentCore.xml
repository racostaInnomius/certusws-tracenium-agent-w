<service>
  <id>TraceniumAgentCore</id>
  <name>Tracenium Agent Core</name>
  <description>Tracenium Agent Core - Control plane, outbox, scheduler.</description>

  <workingdirectory>%BASE%\app</workingdirectory>

  <!-- Si empacas Node embebido -->
  <executable>%BASE%\node\node.exe</executable>
  <arguments>"%BASE%\app\dist\index.js"</arguments>

  <logpath>%BASE%\logs</logpath>
	  <log mode="roll-by-time">
  	<pattern>yyyyMMdd</pattern>
  	<keepFiles>14</keepFiles>
	  </log>

  <env name="NODE_ENV" value="production" />
  <!--
    Default endpoint sin puerto explícito. El agent (config.ts
    resolveGrpcEndpoint) lo resuelve a :443. Corporate firewalls ya
    tienen 443 outbound abierto (HTTPS estándar) — sin ticket de
    change-control para puertos custom. El backend gRPC escucha en
    443+50051 durante la transición. Operadores que requieran puerto
    explícito pueden override aquí (ej. "host:50051").
  -->
  <env name="GRPC_ENDPOINT" value="grpc.tracenium.com" />
  <env name="CHANNEL" value="stable" />

  <onfailure action="restart" delay="5 sec" />
</service>