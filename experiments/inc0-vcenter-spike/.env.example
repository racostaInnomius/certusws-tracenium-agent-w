# ADR-0001 Inc 0 spike — copy to .env and fill in. NEVER commit the real .env.
#   set -a; source .env; set +a; node vcenter-spike.mjs
# (or: env $(grep -v '^#' .env | xargs) node vcenter-spike.mjs)

# --- vCenter connection (required) ---
VC_URL=https://vcenter.lab.local
VC_USER=svc-tracenium@vsphere.local
VC_PASS=changeme

# --- TLS (pick ONE; default is system CA verification) ---
# Skip verification entirely (lab only):
VC_INSECURE=true
# ...or pin the server cert SHA-256 (the script prints it on first run):
# VC_THUMBPRINT=AB:CD:EF:...

# --- Correlation target (set at least ONE) ---
# The SMBIOS UUID exactly as the Tracenium agent reports it (system.uuid).
# Leave empty on the first run to just LIST all VMs + their config.uuid.
TARGET_VM_UUID=
# Optional fallback / disambiguation by VM name:
TARGET_VM_NAME=

# --- Snapshot behavior ---
SNAP_QUIESCE=true      # app-consistent (VSS) on Windows guests; default true
SNAP_MEMORY=false      # capture RAM (slow/large); default false
SPIKE_CREATE=true      # create + remove a snapshot; default true
SPIKE_REVERT=false     # ALSO test revert — DISRUPTIVE (rolls the VM back!); default false
