dist/
out/
release/
node_modules/
*.exe
*.pkg
*.deb
*.rpm
*.dmg
*.msi
.env

# Exception: WinSW service wrapper binaries committed to the repo as
# the Windows service entry point. They're pinned (per-arch) instead
# of downloaded at build time so CI doesn't depend on WinSW's release
# infrastructure (their v3 URLs have moved across alpha releases).
!packaging/windows/core-service/*.exe

# ── Build outputs (Phase A consolidation, May 2026) ─────────────────
# /build/ holds transient outputs from build-*.sh + esbuild + nfpm.
# Historical: a previous commit accidentally tracked ~600 files under
# build/ (caches, intermediate node tarballs, etc). Cleaning those up
# is a separate task — for now we only ignore NEW additions:
build/macos/
build/linux/
build/windows/
build/win-binaries/
build/win-msi/
build/agentcore/
# Cache de distribuciones de Node descargadas por los scripts de build.
# Patron global: la regla original solo cubria `build/.node-cache/` y dejaba
# fuera `build/linux/.node-cache/`, donde quedaron trackeados 16 archivos /
# 61 MB (tarballs de node-v24 x64+arm64 y su arbol extraido). Se redescargan
# solos si faltan.
**/.node-cache/
build/.npm-cache/
# node-gyp's header cache. Committing ANY of it breaks CI in a subtle
# way: node-gyp reads <version>/installVersion as "headers are already
# here" and skips the download, so a checkout that carries the marker
# without the headers fails with "common.gypi not found" the first time
# a native module actually needs rebuilding.
build/.node-gyp/

# ── WiX intermediate outputs (Windows MSI build) ────────────────────
*.wixpdb
*.wixobj
build.log

# ── OS / IDE noise ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
Thumbs.db:encryptable

# ── Test outputs (Vitest coverage) ──────────────────────────────────
coverage/

# SwiftPM transient build output of the macOS status app. Was tracked by
# mistake — every `swift build` churns ~1500 .pcm/object files and buries
# real diffs (the "1771 modified files" incident, 2026-07-28).
macos/TraceniumAgentStatus/.build/

# ── .NET build output (PrivSvc + AgentTray) ─────────────────────────
# bin/ y obj/ son salidas regenerables de MSBuild. Estaban trackeadas por
# error: 150 archivos / 10.2 MB que reaparecen modificados en cada
# `dotnet build` y entierran los cambios reales en `git status` — el mismo
# problema que el .build/ de SwiftPM de arriba. El CI compila desde fuente
# con `-c Release` y publica aparte, así que nada del pipeline depende de
# estos archivos.
**/bin/Debug/
**/bin/Release/
**/obj/
