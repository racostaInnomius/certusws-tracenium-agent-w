<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Tracenium Agent</title>

  <welcome file="welcome.html" />
  <readme file="readme.html" />
  <license file="license.html" />
  <conclusion file="conclusion.html" />

  <background file="tracenium_pgk.png" alignment="center" scaling="proportional" />

  <options customize="never" require-scripts="true" />
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true" />

  <pkg-ref id="com.certusws.tracenium.agent" version="1.0.88" auth="Root">TraceniumAgentComponent.pkg</pkg-ref>

  <choices-outline>
    <line choice="tracenium-agent" />
  </choices-outline>

  <choice id="tracenium-agent" title="Tracenium Agent" visible="false" selected="true" enabled="false">
    <pkg-ref id="com.certusws.tracenium.agent" />
  </choice>
</installer-gui-script>
